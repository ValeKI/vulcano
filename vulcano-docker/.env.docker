FLASK_ENV=docker
FLASK_APP=vulcano_be.py

# generali
SECRET_KEY=docker-secret-key
REFRESH_SECRET_KEY=docker-refresh-secret

# frontend
FRONTEND_BASE_URL=http://vulcano_fe:5173

# database
DB_NAME=vulcanodb
DB_USER=vulcanoroot
DB_PASSWORD=stromboli
DB_HOST=postgres
DB_PORT=5432

# SMTP
SMTP_USER=vulcano@example.com
SMTP_PASSWORD=
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SSL=False

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=vulcano-minio

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=files

# Embedding
# OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Prompt
REWRITER_SYSTEM_PROMPT=Sei un assistente che risponde SOLO usando le informazioni contenute nei content.\nDEVI SEMPRE seguire questo formato di risposta:\n\nFILE_UTILIZZATI[ID1, ID2, ...]: La tua risposta qui...\n\nEsempio:\nFILE_UTILIZZATI[1, 3]: Le postazioni sono divise in...\n\nSe la risposta non è presente nei content, rispondi:\nFILE_UTILIZZATI[]: L'informazione richiesta non è disponibile nei file.
RETRIEVAL_PROMPT_TEMPLATE=Retrieved content:\n{% for chunk in chunks %}\n[file_id:{{ chunk.metadata.file_id }}]{{ chunk.text }}\n{% endfor %}\n\nIMPORTANTE: La tua risposta DEVE iniziare con 'FILE_UTILIZZATI[' seguito dagli ID dei file utilizzati, poi ']:' e infine la risposta.\nEsempio: FILE_UTILIZZATI[1, 2]: La risposta qui...\nSe non trovi informazioni rilevanti, rispondi: FILE_UTILIZZATI[]: Informazione non disponibile nei file.
GENERATOR_SYSTEM_PROMPT=Sei un assistente che deve SEMPRE rispondere nel seguente formato:\nFILE_UTILIZZATI[ID1, ID2, ...]: La tua risposta qui...\n\nEsempio corretto: FILE_UTILIZZATI[1, 3]: Le postazioni sono divise in...\nSe non ci sono informazioni: FILE_UTILIZZATI[]: Informazione non disponibile nei file.\n\nNON RISPONDERE MAI SENZA USARE QUESTO FORMATO!